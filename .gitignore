# Секреты — НИКОГДА не коммитим (ключи только в .env на сервере)
.env
**/.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
secrets/

# Python / backend
.venv/
__pycache__/
*.pyc
*.db
*.sqlite3

# Node / frontend
node_modules/
dist/

# IDE
.idea/
.vscode/
*.iml
*.log

# OS
.DS_Store

# Мокапы: храним обзорные + раскадровку, остальное генерится скриптами
mockups/*.png
!mockups/overview.png
!mockups/tma_overview.png
!mockups/storyboard.png
!mockups/admin.png

# вложенные мокап-скриншоты (генерируются на лету)
mockups/**/*.png

# Скриншоты экранов и следы Playwright: их снимают на время проверки и в
# репозиторий не кладут (один такой файл уже уезжал в историю по недосмотру).
tma/shots/
shots/
playwright-report/
test-results/

# Сквозные проверки в браузере (e2e/): всё, что создаётся прогоном
e2e/.tmp/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
