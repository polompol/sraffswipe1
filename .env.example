# Прод-конфиг StaffSwipe (docker-compose.prod.yml).
# Скопируйте:  cp .env.example .env   и заполните значения.
# Секреты сгенерируйте:  bash scripts/gen-secrets.sh

# --- ОБЯЗАТЕЛЬНО ---

# Домен, на котором висит Mini App (без https://). DNS A-запись → IP сервера.
DOMAIN=app.example.ru

# Токен бота из @BotFather.
TELEGRAM_BOT_TOKEN=

# Username бота без @ (для реферальных ссылок t.me/<bot>?startapp=...).
BOT_USERNAME=staffswipe_bot

# Пароль БД — придумайте длинный случайный (gen-secrets.sh подскажет).
POSTGRES_PASSWORD=

# Секрет подписи JWT — случайный, длинный.
JWT_SECRET=

# Секрет для внутренних вызовов (бот/вебхук → /billing/fulfill) — случайный.
INTERNAL_API_SECRET=

# --- ЮРИДИЧЕСКОЕ (нужно на публичный запуск, 152-ФЗ) ---
# Ссылки на оферту и политику обработки ПДн (опубликуйте docs/legal/*).
VITE_OFFER_URL=
VITE_PRIVACY_URL=
# Ссылка на поддержку (Telegram-чат/бот) — раздел «Помощь».
VITE_SUPPORT_URL=

# --- ОПЦИОНАЛЬНО (можно оставить пустым на пилоте) ---

# Эффект «печатает…» + плавное раскрытие текста бота. 1 — вкл, 0 — выкл.
# По умолчанию выключен: ради анимации бот правит сообщение десять раз, а
# человек эти секунды просто ждёт.
BOT_TYPEWRITER=0

# Telegram-id админов через запятую — доступ к админ-панели и аналитике.
# Уже вписан id владельца (это не секрет: войти под ним может только сам
# владелец Telegram-аккаунта). Второго оператора добавлять через запятую.
ADMIN_TG_IDS=

# DaData — проверка ИНН/ОГРН заведений.
DADATA_TOKEN=
DADATA_SECRET=

# S3-хранилище фото (напр. Yandex Object Storage). Без ключей загрузка фото
# отдаёт 503, остальное работает.
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
S3_PUBLIC_BASE=

# Sentry DSN для наблюдаемости ошибок.
SENTRY_DSN=

# Часовой пояс, в котором люди читают время смены. Сервер живёт в UTC, а
# «смена 10:00–18:00» — местное время: без этого напоминания и авто-закрытие
# смен уезжают на три часа. Другой город — поменяй значение.
BUSINESS_TZ=Europe/Moscow

# Адрес хранилища фото для правил безопасности браузера (CSP).
# Файл уходит туда напрямую, минуя наш домен, и без этой строки
# браузер молча зарежет загрузку. Пример: https://storage.yandexcloud.net
# Пусто — загрузка фото не подключена.
UPLOAD_ORIGIN=

# Общее состояние процессов приложения (счётчики частоты, раздача чата).
# В docker-compose.prod.yml контейнер уже поднимается, менять не нужно.
# Пусто = всё в памяти одного процесса, тогда WEB_CONCURRENCY обязан быть 1.
REDIS_URL=redis://redis:6379/0

# Сколько рабочих процессов у API. Больше 1 — только с REDIS_URL.
WEB_CONCURRENCY=1

# --- ДЕНЬГИ: ЮKassa (оплата картой) ---
# Пока пусто — кнопка «Оплатить картой» честно говорит, что оплата картой
# скоро, а баланс пополняет оператор в админке (принял перевод → зачислил).
# Значения берутся в личном кабинете ЮKassa после подключения магазина.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Секрет вебхука — ЛЮБАЯ случайная строка (gen-secrets.sh подойдёт). Его же
# подставляете в адрес уведомления в кабинете ЮKassa:
#   https://ДОМЕН/api/billing/yookassa/webhook?secret=ЭТА_СТРОКА
# Пусто — используется INTERNAL_API_SECRET. Отдельный секрет лучше: адрес
# уведомления живёт в чужом кабинете, и его утечка не откроет ничего больше.
YOOKASSA_WEBHOOK_SECRET=
# 54-ФЗ. Самозанятому — false: чек формируется в «Мой налог», отдельная касса
# не нужна. ИП/ООО, если касса не фискализирует сама, — true.
YOOKASSA_SEND_RECEIPT=false
# Ставка НДС в чеке: 1 — без НДС (самозанятый/УСН), 6 — НДС 20%.
YOOKASSA_VAT_CODE=1
# Куда вернуть человека после оплаты. Пусто — в чат с ботом, оттуда одна
# кнопка до приложения.
PAYMENT_RETURN_URL=

# --- Комиссия (значения по умолчанию менять не обязательно) ---
# Процент с закрытой смены. 0 — комиссия выключена совсем.
COMMISSION_PCT=10
# Минимум комиссии за смену, ₽ (чтобы дешёвая смена не давала копейки).
COMMISSION_MIN_RUB=0
# Через сколько дней неоплаченная комиссия считается просрочкой: после этого
# заведение не может публиковать смены и звать новых людей. 0 — не блокировать.
COMMISSION_DUE_DAYS=7
# За сколько часов до смены отмена работником считается «поздней».
LATE_CANCEL_HOURS=6

# --- Реквизиты получателя платежа: счёт и акт для ресторана-юрлица ---
# Без них ресторан не оплатит комиссию по безналу и не поставит расход.
# Пока пусто — документы не выдаются (лучше отказ, чем бумага с прочерками).
ORG_NAME=
ORG_INN=
ORG_KPP=
ORG_OGRN=
ORG_ADDRESS=
ORG_BANK_NAME=
ORG_BANK_BIC=
ORG_BANK_ACCOUNT=
ORG_CORR_ACCOUNT=
ORG_SIGNER=
ORG_VAT=false
